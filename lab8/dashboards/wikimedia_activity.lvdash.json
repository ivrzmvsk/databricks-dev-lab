{
  "datasets": [
    {
      "displayName": "edits",
      "name": "edits",
      "queryLines": [
        "SELECT f.event_id, f.event_time, f.event_date, f.bucket_start, f.wiki,\n",
        "      w.language_code, w.project_code, w.site_name, p.title, e.user_name,\n",
        "      n.namespace_name, f.editor_key, f.page_key, f.bytes_delta,\n",
        "      CASE WHEN f.bot THEN 'Bot' ELSE 'Human / unspecified' END AS editor_type\n",
        "    FROM fact_edits f\n",
        "    JOIN dim_wiki w ON f.wiki_key = w.wiki_key\n",
        "    JOIN dim_date d ON f.date_key = d.date_key\n",
        "    JOIN dim_page p ON f.page_key = p.page_key\n",
        "    JOIN dim_editor e ON f.editor_key = e.editor_key\n",
        "    JOIN dim_namespace n ON f.namespace_key = n.namespace_key"
      ]
    },
    {
      "displayName": "five",
      "name": "five",
      "queryLines": [
        "SELECT a.*, CAST(a.bucket_start AS DATE) AS event_date,\n",
        "      w.language_code, w.project_code FROM agg_wiki_5min a\n",
        "      JOIN dim_wiki w ON a.wiki_key = w.wiki_key"
      ]
    },
    {
      "displayName": "daily",
      "name": "daily",
      "queryLines": [
        "SELECT a.*, w.language_code, w.project_code FROM agg_wiki_daily a\n",
        "      JOIN dim_wiki w ON a.wiki_key = w.wiki_key"
      ]
    },
    {
      "displayName": "pages",
      "name": "pages",
      "queryLines": [
        "WITH top_pages AS (\n",
        "      SELECT page_key FROM agg_page_activity\n",
        "      GROUP BY page_key ORDER BY SUM(edit_count) DESC, page_key LIMIT 20\n",
        "    )\n",
        "    SELECT a.*, p.title, CONCAT(a.wiki, ': ', p.title) AS page_label,\n",
        "      w.language_code, w.project_code FROM agg_page_activity a\n",
        "      JOIN top_pages t ON a.page_key = t.page_key\n",
        "      JOIN dim_page p ON a.page_key = p.page_key JOIN dim_wiki w ON a.wiki_key = w.wiki_key"
      ]
    }
  ],
